{
    "name": "markocupic/composer-file-copier-plugin",
    "description": "Copy files or mirroring folders from a package dist directory to the filesystem during 'composer-install-cmd' or 'composer-update-cmd'.",
    "type": "composer-plugin",
    "homepage": "https://github.com/markocupic/composer-file-copier-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/composer-file-copier-plugin/issues",
        "source": "https://github.com/markocupic/composer-file-copier-plugin"
    },
    "require": {
        "php": "^8.3",
        "composer-plugin-api": "^2.1",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "composer/composer": "^2.6",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\Composer\\Plugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\Composer\\Plugin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Markocupic\\Composer\\Plugin\\Plugin"
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --fix --ansi",
        "cs-check": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
